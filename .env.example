# Copy this file to ".env" and fill in your key. ".env" is ignored by git and stays on your machine.
# Real environment variables always win over values in this file.

# Free Gemini key from https://aistudio.google.com/apikey
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
LLM_MODEL=gemini-3.6-flash
LLM_FALLBACK_MODELS=gemini-3.5-flash-lite,gemini-3.8-flash
LLM_API_KEY=

# Speed: Gemini 3 models "think" before the first word. "minimal" cut the wait from about 3-4 s to
# about 1.3 s in measurements (answers stayed correct on the samples tried). The first applies to answers
# from your documents and to rewriting follow-ups; the second to general-knowledge answers. For hard
# reasoning or coding questions in General mode, leave the second empty to let the model think longer.
# A model that does not accept the setting is retried without it automatically.
LLM_REASONING_EFFORT=minimal
LLM_REASONING_EFFORT_GENERAL=minimal

# Load the search model when the server starts instead of on the first question (saves 10-20 s).
# scripts\start.ps1 and docker-compose already do this; set it if you run "manage.py runserver" yourself.
# WARMUP_EMBEDDINGS=1

# Or, instead of the Gemini lines above, a paid Anthropic key:
# ANTHROPIC_API_KEY=

# Optional: trace every model call in LangSmith (https://smith.langchain.com), free tier available.
# Each question appears as a run named answer_from_documents, answer_general or rewrite_followup, with the
# exact prompt, the reply, timings and token counts. PRIVACY: this sends your questions, the retrieved
# passages of your documents and the answers to LangSmith's servers. Leave it off for confidential files.
# LANGSMITH_TRACING=true
# LANGSMITH_API_KEY=
# LANGSMITH_PROJECT=answertrail
