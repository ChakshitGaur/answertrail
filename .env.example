# Copy this file to ".env" and fill in your key. ".env" is ignored by git and stays on your machine.
# Real environment variables always win over values in this file.

# Free Gemini key from https://aistudio.google.com/apikey
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
LLM_MODEL=gemini-3.6-flash
LLM_FALLBACK_MODELS=gemini-3.5-flash-lite,gemini-3.8-flash
LLM_API_KEY=

# Or, instead of the four lines above, a paid Anthropic key:
# ANTHROPIC_API_KEY=
